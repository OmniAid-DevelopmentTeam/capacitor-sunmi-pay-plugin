{
  "name": "capacitor-sunmi-pay",
  "version": "0.0.7",
  "description": "Capacitor plugin for Sunmi Payment SDK - provides card reading, EMV processing, PIN input, security operations, and printing capabilities for Sunmi POS devices",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/",
    "dist/"
  ],
  "author": "Sunmi Capacitor Plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OmniAid-DevelopmentTeam/capacitor-sunmi-pay-plugin"
  },
  "bugs": {
    "url": "https://github.com/OmniAid-DevelopmentTeam/capacitor-sunmi-pay-plugin/issues"
  },
  "homepage": "https://github.com/OmniAid-DevelopmentTeam/capacitor-sunmi-pay-plugin#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "sunmi",
    "payment",
    "pos",
    "emv",
    "card-reader",
    "nfc",
    "android"
  ],
  "scripts": {
    "verify": "npm run verify:android && npm run verify:web",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\"",
    "docgen": "docgen --api SunmiPayPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/docgen": "^0.2.0",
    "@ionic/eslint-config": "^0.3.0",
    "@ionic/prettier-config": "^4.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^8.40.0",
    "prettier": "~3.0.0",
    "prettier-plugin-java": "~2.2.0",
    "rimraf": "^5.0.0",
    "rollup": "^3.21.0",
    "typescript": "~5.0.4"
  },
  "peerDependencies": {
    "@capacitor/core": "^5.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}
